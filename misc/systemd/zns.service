[Unit]
Description=zns service
After=network.target

[Service]
LimitNOFILE=8192
EnvironmentFile=/etc/zns/env
ExecStart=/usr/local/bin/zns -c /etc/zns/zns.toml
ExecReload=/bin/kill -HUP $MAINPID
User=www-data
Group=www-data
KillMode=process
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
